{
  "manifest_version": 3,
  "name": "Pin to Figma",
  "version": "1.0",
  "description": "One click on a Pinterest pin sends the image to Figma.",
  "icons": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "host_permissions": ["http://127.0.0.1:3737/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://*.pinterest.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
